{
  "primitive": {
    "color": {
      "$type": "color",
      "white": { "$value": "#FFFFFF" },
      "slate": {
        "50": { "$value": "#F8FAFC" },
        "100": { "$value": "#F1F5F9" },
        "200": { "$value": "#E2E8F0" },
        "300": { "$value": "#CBD5E1" },
        "400": { "$value": "#94A3B8" },
        "500": { "$value": "#64748B" },
        "600": { "$value": "#475569" },
        "700": { "$value": "#334155" },
        "800": { "$value": "#1E293B" },
        "900": { "$value": "#0F172A" },
        "950": { "$value": "#020617" }
      },
      "indigo": {
        "500": { "$value": "#6366F1" },
        "600": { "$value": "#4F46E5" },
        "700": { "$value": "#4338CA" }
      },
      "emerald": { "600": { "$value": "#059669" } },
      "amber": { "500": { "$value": "#F59E0B" } },
      "red": { "600": { "$value": "#DC2626" } },
      "chart": {
        "1": { "$value": "#4F46E5" },
        "2": { "$value": "#10B981" },
        "3": { "$value": "#F59E0B" },
        "4": { "$value": "#0EA5E9" },
        "5": { "$value": "#F43F5E" }
      }
    },
    "space": {
      "$type": "dimension",
      "0.5": { "$value": "2px" },
      "1": { "$value": "4px" },
      "2": { "$value": "8px" },
      "3": { "$value": "12px" },
      "4": { "$value": "16px" },
      "5": { "$value": "20px" },
      "6": { "$value": "24px" },
      "8": { "$value": "32px" },
      "10": { "$value": "40px" },
      "12": { "$value": "48px" },
      "16": { "$value": "64px" }
    },
    "radius": {
      "$type": "dimension",
      "sm": { "$value": "4px" },
      "md": { "$value": "8px" },
      "lg": { "$value": "12px" },
      "full": { "$value": "9999px" }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "sans": { "$value": ["Inter", "system-ui", "sans-serif"] }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400 },
        "medium": { "$value": 500 },
        "semibold": { "$value": 600 },
        "bold": { "$value": 700 }
      },
      "size": {
        "$type": "dimension",
        "xs": { "$value": "0.75rem" },
        "sm": { "$value": "0.875rem" },
        "base": { "$value": "1rem" },
        "lg": { "$value": "1.125rem" },
        "xl": { "$value": "1.25rem" },
        "2xl": { "$value": "1.5rem" },
        "3xl": { "$value": "1.875rem" }
      }
    },
    "motion": {
      "$type": "duration",
      "fast": { "$value": "150ms" },
      "base": { "$value": "200ms" }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "accent": { "$value": "{primitive.color.indigo.600}" },
      "accent-hover": { "$value": "{primitive.color.indigo.700}" },
      "accent-ring": { "$value": "{primitive.color.indigo.500}" },
      "surface": { "$value": "{primitive.color.white}" },
      "surface-muted": { "$value": "{primitive.color.slate.50}" },
      "text": { "$value": "{primitive.color.slate.900}" },
      "text-muted": { "$value": "{primitive.color.slate.500}" },
      "text-on-accent": { "$value": "{primitive.color.white}" },
      "border": { "$value": "{primitive.color.slate.200}" },
      "success": { "$value": "{primitive.color.emerald.600}" },
      "warning": { "$value": "{primitive.color.amber.500}" },
      "danger": { "$value": "{primitive.color.red.600}" },
      "focus-ring": { "$value": "{primitive.color.indigo.500}" },
      "chart-1": { "$value": "{primitive.color.chart.1}" },
      "chart-2": { "$value": "{primitive.color.chart.2}" },
      "chart-3": { "$value": "{primitive.color.chart.3}" },
      "chart-4": { "$value": "{primitive.color.chart.4}" },
      "chart-5": { "$value": "{primitive.color.chart.5}" },
      "sidebar": { "$value": "{primitive.color.white}" },
      "sidebar-foreground": { "$value": "{primitive.color.slate.700}" },
      "sidebar-accent": { "$value": "{primitive.color.slate.100}" },
      "sidebar-accent-foreground": { "$value": "{primitive.color.slate.900}" },
      "sidebar-border": { "$value": "{primitive.color.slate.200}" },
      "sidebar-ring": { "$value": "{primitive.color.indigo.500}" }
    },
    "space": {
      "$type": "dimension",
      "inset-xs": { "$value": "{primitive.space.2}" },
      "inset-sm": { "$value": "{primitive.space.3}" },
      "inset-md": { "$value": "{primitive.space.4}" },
      "inset-lg": { "$value": "{primitive.space.6}" },
      "gap-sm": { "$value": "{primitive.space.2}" },
      "gap-md": { "$value": "{primitive.space.4}" }
    },
    "radius": {
      "$type": "dimension",
      "control": { "$value": "{primitive.radius.md}" },
      "card": { "$value": "{primitive.radius.lg}" }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "base": { "$value": "{primitive.font.family.sans}" }
      },
      "weight": {
        "$type": "fontWeight",
        "normal": { "$value": "{primitive.font.weight.regular}" },
        "emphasis": { "$value": "{primitive.font.weight.semibold}" },
        "strong": { "$value": "{primitive.font.weight.bold}" }
      },
      "size": {
        "$type": "dimension",
        "body": { "$value": "{primitive.font.size.sm}" },
        "heading": { "$value": "{primitive.font.size.xl}" },
        "display": { "$value": "{primitive.font.size.3xl}" }
      }
    }
  },
  "component": {
    "button": {
      "bg": { "$type": "color", "$value": "{semantic.color.accent}" },
      "bg-hover": { "$type": "color", "$value": "{semantic.color.accent-hover}" },
      "label": { "$type": "color", "$value": "{semantic.color.text-on-accent}" },
      "padding": { "$type": "dimension", "$value": "{semantic.space.inset-md}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.control}" },
      "ring": { "$type": "color", "$value": "{semantic.color.focus-ring}" }
    },
    "card": {
      "bg": { "$type": "color", "$value": "{semantic.color.surface}" },
      "text": { "$type": "color", "$value": "{semantic.color.text}" },
      "border": { "$type": "color", "$value": "{semantic.color.border}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.card}" },
      "gap": { "$type": "dimension", "$value": "{semantic.space.gap-md}" }
    },
    "dialog": {
      "bg": { "$type": "color", "$value": "{semantic.color.surface}" },
      "text": { "$type": "color", "$value": "{semantic.color.text}" },
      "border": { "$type": "color", "$value": "{semantic.color.border}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.card}" }
    },
    "input": {
      "bg": { "$type": "color", "$value": "{semantic.color.surface}" },
      "text": { "$type": "color", "$value": "{semantic.color.text}" },
      "border": { "$type": "color", "$value": "{semantic.color.border}" },
      "ring": { "$type": "color", "$value": "{semantic.color.focus-ring}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.control}" }
    },
    "select": {
      "bg": { "$type": "color", "$value": "{semantic.color.surface}" },
      "text": { "$type": "color", "$value": "{semantic.color.text}" },
      "border": { "$type": "color", "$value": "{semantic.color.border}" },
      "ring": { "$type": "color", "$value": "{semantic.color.focus-ring}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.control}" }
    },
    "badge": {
      "bg": { "$type": "color", "$value": "{semantic.color.surface-muted}" },
      "text": { "$type": "color", "$value": "{semantic.color.text-muted}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.control}" }
    },
    "table": {
      "header-bg": { "$type": "color", "$value": "{semantic.color.surface-muted}" },
      "text": { "$type": "color", "$value": "{semantic.color.text}" },
      "border": { "$type": "color", "$value": "{semantic.color.border}" }
    },
    "sidebar": {
      "bg": { "$type": "color", "$value": "{semantic.color.sidebar}" },
      "fg": { "$type": "color", "$value": "{semantic.color.sidebar-foreground}" },
      "accent": { "$type": "color", "$value": "{semantic.color.sidebar-accent}" },
      "accent-fg": { "$type": "color", "$value": "{semantic.color.sidebar-accent-foreground}" },
      "border": { "$type": "color", "$value": "{semantic.color.sidebar-border}" },
      "ring": { "$type": "color", "$value": "{semantic.color.sidebar-ring}" }
    },
    "chart": {
      "1": { "$type": "color", "$value": "{semantic.color.chart-1}" },
      "2": { "$type": "color", "$value": "{semantic.color.chart-2}" },
      "3": { "$type": "color", "$value": "{semantic.color.chart-3}" },
      "4": { "$type": "color", "$value": "{semantic.color.chart-4}" },
      "5": { "$type": "color", "$value": "{semantic.color.chart-5}" }
    },
    "stat-card": {
      "bg": { "$type": "color", "$value": "{semantic.color.surface}" },
      "label": { "$type": "color", "$value": "{semantic.color.text-muted}" },
      "value": { "$type": "color", "$value": "{semantic.color.text}" },
      "up": { "$type": "color", "$value": "{semantic.color.success}" },
      "down": { "$type": "color", "$value": "{semantic.color.danger}" }
    }
  }
}
